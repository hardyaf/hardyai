APP_ENV=development
DEFAULT_SESSION_SOURCE=web
MICRO_FAST_CONFIDENCE_THRESHOLD=0.72

# Micro model backend (optional)
MICRO_MODEL_ENABLED=false
MICRO_MODEL_PROVIDER=ollama
MICRO_MODEL_NAME=qwen2.5:7b
LOCAL_MODEL_URL=http://127.0.0.1:11434
MICRO_MODEL_TIMEOUT_SECONDS=6.0
# Per-request Ollama allocation. This overrides the server default for the Micro lane.
MICRO_MODEL_NUM_CTX=4096
MICRO_MODEL_NUM_PREDICT=256
MICRO_MODEL_HEURISTIC_FALLBACK_ENABLED=true

# Main semantic repair backend (optional)
# Main conversation follows the main repair model when enabled.
MAIN_REPAIR_MODEL_ENABLED=false
MAIN_REPAIR_MODEL_PROVIDER=ollama
MAIN_REPAIR_MODEL_NAME=gpt-oss:20b
MAIN_REPAIR_MODEL_TIMEOUT_SECONDS=8.0
MAIN_REPAIR_MODEL_NUM_CTX=12288
MAIN_REPAIR_MODEL_NUM_PREDICT=512
# Main conversation timeout can be tuned separately for local-model warmup latency.
MAIN_CONVERSATION_MODEL_TIMEOUT_SECONDS=20.0
MAIN_CONVERSATION_MODEL_NUM_CTX=12288
MAIN_CONVERSATION_MODEL_NUM_PREDICT=1024
# Keep larger model lanes warm while recent task labels still require them.
# Rule: cool down after this many seconds where labels are micro-only (or no tasks).
LARGER_MODEL_MICRO_ONLY_WINDOW_SECONDS=180
# Set false for source-checkout deployments so runtime activity cannot rewrite
# tracked compiled prompt artifacts. Release artifacts must already be present.
SKILL_ARTIFACT_AUTO_COMPILE_ENABLED=true

# Main agent loop (planner -> action -> evaluator)
MAIN_AGENT_LOOP_MAX_STEPS=8
MAIN_AGENT_LOOP_MAX_FAILURES=2
MAIN_AGENT_LOOP_CONTEXT_MAX_CHARS=6000
MAIN_AGENT_LOOP_AUTO_APPROVE_ACTIONS=true
MAIN_AGENT_CONTENT_POLICY_ENABLED=true
MAIN_AGENT_CONTENT_POLICY_CHILDREN_ONLY=true
MAIN_AGENT_CONTENT_POLICY_BLOCKED_PATTERNS=kill,weapon,drug,explicit,porn
MAIN_AGENT_TOKEN_SESSION_ENABLED=true
MAIN_AGENT_TOKEN_SESSION_MAX_TURNS=12
# Conversational confidence policy (main repair -> clarify vs execute)
MAIN_CONVERSATIONAL_CONFIDENCE_THRESHOLD=0.70
MAIN_LOW_CONFIDENCE_FLOOR=0.55
MAIN_HIGH_RISK_CONFIDENCE_THRESHOLD=0.80
MAIN_STICKY_FOLLOWUP_TURNS=2
# Pending clarification behavior:
# false = when main repair/model gives no usable fields, ask again (no generic parser fallback)
MAIN_PENDING_CLARIFICATION_HEURISTIC_FALLBACK_ENABLED=false

# Optional read-only conversational web research. Run a private SearXNG instance;
# only the minimal query is sent to its configured upstream search engines.
WEB_RESEARCH_ENABLED=false
WEB_RESEARCH_PROVIDER=searxng
WEB_RESEARCH_BASE_URL=http://127.0.0.1:8080
WEB_RESEARCH_TIMEOUT_SECONDS=15
WEB_RESEARCH_DECISION_TIMEOUT_SECONDS=60
WEB_RESEARCH_DECISION_MODEL_NUM_CTX=12288
WEB_RESEARCH_DECISION_MODEL_NUM_PREDICT=256
WEB_RESEARCH_MAX_RESULTS=5
# 0=off, 1=moderate, 2=strict. Child research forces strict when enabled.
WEB_RESEARCH_SAFE_SEARCH=1
WEB_RESEARCH_CHILDREN_ENABLED=false
WEB_RESEARCH_CACHE_TTL_SECONDS=900

# Channel-scoped session lifecycle (MVP): reuse while active, rotate after idle timeout.
CHANNEL_SESSION_IDLE_TIMEOUT_SECONDS=180

# Persistence
DATABASE_PATH=./data/jarvis_v2.db
MEMORY_MODE=sqlite
MEMORY_MARKDOWN_PATH=./data/memory_markdown
HOUSE_SWITCH_NAMES=office test light,kitchen light,living room lamp,bedroom lamp

# Calendar (optional Google live read/write via OAuth + permissions mapping)
# Recommended: point this to your private copy under `secrets/live/`.
CALENDAR_GOOGLE_ENABLED=false
GOOGLE_PERMISSIONS_PATH=secrets/live/google_permissions.yaml
CALENDAR_INBOX_ENABLED=false
CALENDAR_INBOX_TIMEZONE=America/New_York
CALENDAR_INBOX_START_HOUR=8
CALENDAR_INBOX_END_HOUR=20
CALENDAR_INBOX_POLL_SECONDS=60
CALENDAR_INBOX_MAX_MESSAGES_PER_RUN=100
CALENDAR_INBOX_LOOKBACK_DAYS=30
# Optional comma-separated override. Empty derives personal sender addresses from non-house calendar bindings.
CALENDAR_INBOX_ALLOWED_SENDER_EMAILS=

# Shared email agent (Gmail read-only + Jarvis-local shadow classification)
# Generate the protected permissions file with scripts/configure_email_agent.py.
EMAIL_AGENT_ENABLED=false
EMAIL_AGENT_SYNC_ENABLED=false
EMAIL_AGENT_PERMISSIONS_PATH=secrets/live/email_agent_permissions.yaml
EMAIL_AGENT_TIMEZONE=America/New_York
EMAIL_AGENT_SCHEDULER_POLL_SECONDS=60
EMAIL_AGENT_SYNC_INTERVAL_SECONDS=600
EMAIL_AGENT_ON_DEMAND_STALE_SECONDS=120
EMAIL_AGENT_MAX_HISTORY_PAGES=5
EMAIL_AGENT_MAX_MESSAGES_PER_RUN=100
EMAIL_AGENT_MAX_INTERACTIVE_MESSAGES=10
EMAIL_AGENT_MAX_BODY_BYTES=1048576
EMAIL_AGENT_REFERENCE_RETENTION_HOURS=72
# Safety gates for the first rollout.
EMAIL_AGENT_ALLOW_HISTORICAL_BACKFILL=false
EMAIL_AGENT_SUMMARY_MODEL_PROVIDER=ollama
EMAIL_AGENT_MODEL_NUM_CTX=12288
EMAIL_AGENT_SUMMARY_NUM_PREDICT=1024
EMAIL_AGENT_CLASSIFIER_NUM_PREDICT=256
EMAIL_AGENT_ALLOW_REMOTE_MODEL=false
EMAIL_AGENT_ATTACHMENT_EXTRACTION_ENABLED=false
EMAIL_AGENT_LABEL_SHADOW_ENABLED=true
EMAIL_AGENT_LABEL_WRITES_ENABLED=false
EMAIL_AGENT_LABEL_TOKEN_PATH=secrets/email-spam-worker/token.json
# Manual Spam and mark-read/complete writes use a separate token and isolated worker. The legacy
# SPAM_* setting names remain for configuration compatibility. Keep off until OAuth consent.
EMAIL_AGENT_SPAM_WRITES_ENABLED=false
EMAIL_AGENT_SPAM_TOKEN_PATH=secrets/email-spam-worker/token.json
# Set true only in an API process where the mailbox token is deliberately not mounted.
EMAIL_AGENT_WORKER_TOKEN_ISOLATED=false
EMAIL_AGENT_SPAM_WORKER_POLL_SECONDS=2
EMAIL_AGENT_SPAM_WORKER_BATCH_SIZE=5
EMAIL_AGENT_SPAM_WORKER_LEASE_SECONDS=60
EMAIL_AGENT_SPAM_MAX_ATTEMPTS=3
EMAIL_AGENT_SPAM_MAX_WRITES_PER_HOUR=5
EMAIL_AGENT_SPAM_MAX_WRITES_PER_DAY=10
# Managed-category writes use their own rate budget in the isolated mailbox worker.
EMAIL_AGENT_LABEL_MAX_WRITES_PER_HOUR=20
EMAIL_AGENT_LABEL_MAX_WRITES_PER_DAY=50

# Action ticket verification (safe rollout defaults)
ACTION_TICKETS_ENABLED=false
ACTION_TICKET_CAPTURE_MODE=shadow
ACTION_TICKET_REVIEW_ENABLED=false
ACTION_TICKET_REVIEW_DELAY_SECONDS=3600
ACTION_TICKET_EXECUTION_WATCHDOG_SECONDS=300
ACTION_TICKET_REVIEW_POLL_SECONDS=10
ACTION_TICKET_REVIEW_LIVE_IDLE_SECONDS=15
ACTION_TICKET_REVIEW_BATCH_SIZE=5
ACTION_TICKET_REVIEW_MAX_ATTEMPTS=3
ACTION_TICKET_REMEDIATION_MAX_GENERATION=3
ACTION_TICKET_REVIEW_MODEL_PROVIDER=ollama
ACTION_TICKET_REVIEW_MODEL_NAME=
ACTION_TICKET_REVIEW_MODEL_TIMEOUT_SECONDS=180
ACTION_TICKET_REVIEW_MODEL_NUM_CTX=12288
ACTION_TICKET_REVIEW_MODEL_NUM_PREDICT=1024
ACTION_TICKET_REVIEW_CONTEXT_MAX_CHARS=32000
ACTION_TICKET_AUTO_REMEDIATION_ENABLED=false

# Optional Plane work-item projection. Jarvis remains locally authoritative.
PLANE_ENABLED=false
PLANE_API_BASE_URL=
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=
PLANE_PROJECT_ID=
PLANE_SYNC_RAW_TRANSCRIPT=false
PLANE_API_TIMEOUT_SECONDS=30

# Required to read raw tickets or manage household identity bindings.
JARVIS_OPERATOR_API_KEY=
# Signed browser session lifetime and bounded turn execution.
JARVIS_OPERATOR_SESSION_TTL_SECONDS=3600
TURN_MAX_CONCURRENCY=1
TURN_QUEUE_CAPACITY=8
TURN_TIMEOUT_SECONDS=240

# Phase 1 Documents gateway and local Paperless archive. Keep disabled until the
# encrypted storage mount, token files, and document Compose profile are provisioned.
OFFLINE_MODE=false
DOCUMENTS_ENABLED=false
DOCUMENTS_LOCAL_ONLY=true
# Ubuntu only: must be a mounted encrypted filesystem; the Compose profile does not create it.
DOCUMENTS_STORAGE_ROOT=/mnt/hardyai-documents
DOCUMENTS_SECRETS_ROOT=/etc/hardyai/documents
PAPERLESS_POSTGRES_UID=999
PAPERLESS_VALKEY_UID=999
DOCUMENTS_DATABASE_PATH=/app/data/documents/documents.db
DOCUMENTS_SPOOL_PATH=/app/data/documents/spool
DOCUMENTS_MAX_UPLOAD_BYTES=52428800
DOCUMENTS_MAX_REQUEST_OVERHEAD_BYTES=1048576
DOCUMENTS_SPOOL_QUOTA_BYTES=2147483648
DOCUMENTS_MIN_FREE_BYTES=1073741824
DOCUMENTS_MAX_IMAGE_PIXELS=64000000
DOCUMENTS_BODY_TIMEOUT_SECONDS=120
DOCUMENTS_GLOBAL_CONCURRENCY=2
DOCUMENTS_PER_PRINCIPAL_CONCURRENCY=1
DOCUMENT_JOB_SOCKET_PATH=/run/jarvis-documents/enqueue.sock
DOCUMENT_ARCHIVE_POLL_SECONDS=5
DOCUMENT_ARCHIVE_MAX_ATTEMPTS=30
DOCUMENTS_PROCESSING_ENABLED=false
DOCUMENTS_ARTIFACTS_PATH=/app/data/documents/artifacts
DOCUMENT_PROCESS_MAX_ATTEMPTS=60
DOCUMENT_PROCESS_LEASE_SECONDS=300
DOCUMENTS_WATCH_ENABLED=false
DOCUMENTS_WATCH_PATH=/app/data/documents/import
DOCUMENTS_WATCH_OWNER_ID=
DOCUMENTS_WATCH_STABLE_SECONDS=5
DOCUMENTS_ORIGIN_RECONCILIATION_ENABLED=false
DOCUMENTS_ORIGIN_OWNER_ID=
DOCUMENTS_ORIGIN_RECONCILIATION_LIMIT=50
DOCUMENTS_DOCLING_ENABLED=false
DOCLING_BASE_URL=http://docling-serve:5001
DOCLING_API_KEY_PATH=/run/secrets/docling_api_key
DOCUMENTS_PADDLEOCR_ENABLED=false
PADDLEOCR_BASE_URL=http://paddleocr-serve:8030
PADDLEOCR_API_KEY_PATH=/run/secrets/paddleocr_api_key
PADDLEOCR_SERVER_VERSION=3.7.0
PADDLEOCR_IMAGE_DIGEST=local-build-required
PADDLEOCR_MODEL_TIER=small
PADDLEOCR_TIMEOUT_SECONDS=300
PADDLEOCR_MAX_RESPONSE_BYTES=67108864
DOCLING_SERVER_VERSION=1.30.0
DOCLING_IMAGE_DIGEST=sha256:0244089785d5ccb7570dfaa593cdc81ec64a1aadc63ffa9dce065064b0a6a807
DOCLING_TIMEOUT_SECONDS=300
DOCLING_MAX_RESPONSE_BYTES=67108864
DOCUMENT_GATEWAY_BASE_URL=http://document-gateway:8010
DOCUMENT_GATEWAY_OPERATOR_KEY_PATH=/run/secrets/jarvis_operator_api_key
PAPERLESS_BASE_URL=http://paperless-webserver:8000
PAPERLESS_READ_TOKEN_PATH=/run/secrets/paperless_read_token
PAPERLESS_READ_USER_ID_PATH=/run/secrets/paperless_read_user_id
PAPERLESS_ARCHIVE_TOKEN_PATH=/run/secrets/paperless_archive_token
PAPERLESS_API_VERSION=10
PAPERLESS_SERVER_VERSION=3.0.5
PAPERLESS_TIMEOUT_SECONDS=60
# Prefer a mounted 0400 secret over a Compose/.env value.
JARVIS_OPERATOR_API_KEY_FILE=/run/secrets/jarvis_operator_api_key

# Optional direct OAuth env vars (if referenced by permissions YAML)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_PROJECT_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth2/callback

# Discord (optional; auto-starts with API when enabled)
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
# Fallback only; policy YAML can override this.
DISCORD_COMMAND_PREFIX=!jarvis
# Optional override; leave blank to enforce channel scope from policy YAML.
DISCORD_COMMAND_CHANNEL_ID=
# Optional override; leave blank to enforce guild scope from policy YAML.
DISCORD_COMMAND_GUILD_ID=
# Optional: path to Discord permissions/policy YAML.
DISCORD_PERMISSIONS_PATH=secrets/live/discord_permissions.yaml
# Enable the isolated, metadata-only Core -> attachment-ingress bridge. The
# sidecar itself must be started with the discord-attachments Compose profile.
DISCORD_ATTACHMENT_INGRESS_ENABLED=false
DISCORD_ATTACHMENT_INGRESS_BASE_URL=http://discord-attachment-ingress:8020
DISCORD_ATTACHMENT_INGRESS_TIMEOUT_SECONDS=180
DISCORD_ATTACHMENT_MAX_PER_MESSAGE=4
