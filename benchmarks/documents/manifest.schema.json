{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hardyai.local/schemas/document-benchmark-manifest-v1.json",
  "title": "HardyAI content-free document benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "split", "cases"],
  "properties": {
    "schema_version": {"const": "1"},
    "corpus_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
    "split": {"enum": ["tuning", "holdout", "synthetic"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id", "relative_path", "sha256", "document_class", "format",
          "expected_route", "expected_pages", "minimum_blocks", "requires_table"
        ],
        "properties": {
          "fixture_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$"},
          "relative_path": {"type": "string", "minLength": 1, "maxLength": 240},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "document_class": {"type": "string", "pattern": "^[a-z0-9_]{1,80}$"},
          "format": {"enum": ["pdf"]},
          "expected_route": {"const": "native_docling"},
          "expected_pages": {"type": "integer", "minimum": 1, "maximum": 100},
          "minimum_blocks": {"type": "integer", "minimum": 1, "maximum": 10000},
          "requires_table": {"type": "boolean"}
        }
      }
    }
  }
}
